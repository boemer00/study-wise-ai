# Environment Configuration
ENVIRONMENT=development  # development, staging, production

# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# AI Services
OPENAI_API_KEY=your_openai_key
